# Umbrel Guardian Configuration
# Generated by install.sh — edit carefully
# ─────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Single admin: your Telegram Chat ID (from @userinfobot)
CHAT_ID=

# Multiple admins: comma-separated chat IDs (overrides CHAT_ID if set)
# CHAT_IDS=123456789,987654321

# Security: comma-separated Telegram user IDs allowed to issue commands.
# If not set, defaults to CHAT_IDS / CHAT_ID (same people get notifications AND can command).
# Set this if you want to restrict who can send /restart, /backup, etc.
# ALLOWED_USERS=123456789

# Path to your Umbrel installation
UMBREL_DIR=/home/umbrel/umbrel

# External drive mount path for backups (leave blank to disable backups)
BACKUP_PATH=

# Backup scope:
#   essential — the files needed to restore apps and settings (default, fast):
#               app-data/, db/, secrets/, umbrel.yaml, and members/ where present
#   full      — complete mirror of UMBREL_DIR via rsync --delete (includes blockchain data)
BACKUP_SCOPE=essential

# Include home/ (your Files and Photos) in essential snapshots.
# Off by default: it can be tens of GB, and essential keeps BACKUP_KEEP dated
# copies, so turning this on multiplies both runtime and space. The full clone
# always includes it regardless of this setting.
# BACKUP_ESSENTIAL_INCLUDE_HOME=n

# Skip regenerable caches in the full clone — app-stores/, thumbnails/,
# file-index/, kopia/, lan-ingress/ and friends. These mirror the paths umbrelOS
# leaves out of its own backups; a restore recreates them. Set to 'n' for a
# byte-for-byte clone at the cost of a much larger, slower backup.
# BACKUP_EXCLUDE_CHURN=y

# Number of essential backup snapshots to retain (full-clone is always one rolling copy)
BACKUP_KEEP=3

# Before a full clone, backup.sh checks the drive is large enough to hold it and
# aborts in seconds if not, rather than filling the drive hours into the run.
# The estimate uses the source filesystem's used space, which is an upper bound.
# Set to 'y' to skip the check and run anyway.
# BACKUP_SKIP_SPACE_CHECK=n

# Daily backup time, 24-hour HH:MM. Interpreted in the SYSTEM timezone, not
# UTC — systemd's OnCalendar uses local time when no zone is given, so check
# `timedatectl` if you care which one that is. Change it from Telegram with
# /backup_time HH:MM, or edit here and run `sudo bash reinstall-services.sh`.
BACKUP_TIME=02:00

# Auto-mount backup drive by label (udev hot-plug + boot service).
# Set to 'y' to enable. Drive is auto-mounted when plugged in and at boot.
AUTO_MOUNT=n

# PIN for /lock and /unlock safe mode. Leave blank to disable safe mode
# entirely — with no PIN set, /lock refuses to engage rather than locking you
# out of your own bot.
LOCK_PIN=

# Cap the systemd journal. umbrelOS ships no limit, and an uncapped journal
# reached 1.8 GB on a Raspberry Pi's SD card — continuous write wear on the
# card, and slow enough to read that disk monitoring timed out. Applied by the
# pre-start hook on every boot, because /etc is restored from the image each
# time. Accepts sizes like 100M, 200M, 1G.
JOURNAL_MAX_SIZE=200M

# Disk usage alert threshold in percent (default: 90)
DISK_THRESHOLD=90

# How long an unchanged problem stays quiet before one reminder, in hours.
# A problem is always reported the moment it appears, changes or gets worse;
# this only governs how often you hear about one that is still exactly the same.
# 0 means never repeat. Takes effect on the next check — nothing to reload.
# Change it from Telegram with /alerts <hours>.
ALERT_REPEAT_HOURS=24

# How often the health check RUNS. Chosen during install, and changeable three
# ways: /interval 15m|30m|1h|3h|12h from Telegram, which rewrites this line and
# applies it immediately; or edit it here and run `sudo bash
# reinstall-services.sh`. Accepted values, and nothing else:
#   *:0/15    every 15 minutes
#   *:0/30    every 30 minutes
#   hourly    every hour
#   0/3:00    every 3 hours
#   0/12:00   every 12 hours
HEALTH_INTERVAL=*:0/30

# Installation directory (set by install.sh)
INSTALL_DIR=/home/umbrel/umbrel/umbrel-guardian
