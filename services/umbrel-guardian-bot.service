[Unit]
Description=Umbrel Guardian Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=umbrel
WorkingDirectory=/home/umbrel/umbrel/umbrel-guardian
# Brief delay so DNS/networking is fully ready after network-online.target
ExecStartPre=/bin/sleep 5
ExecStart=/home/umbrel/umbrel/umbrel-guardian/.venv/bin/python3 /home/umbrel/umbrel/umbrel-guardian/bot/guardian_bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/umbrel/umbrel/umbrel-guardian
MemoryMax=128M
# CPUQuota applies to the whole cgroup — the bot AND every process it spawns.
# `umbreld client` is Node and burns ~2.7s of CPU per query, so under this quota
# it takes ~19s wall instead of ~1.8s. Measured on a live node. Any timeout on an
# umbreld call from the bot has to budget for that multiplier; scripts use 45s
# and the bot allows 90s for the commands that make such a call. The limit stays
# because a runaway bot must not be able to starve a Bitcoin node — the answer is
# realistic timeouts, not a weaker sandbox.
# 100%, i.e. one core. 20% was strangling the thing it exists to protect.
# Measured on a Pi 4 running umbrelOS 2.0, one umbreld query: 19.2s
# unconstrained, 110s inside CPUQuota=20%. Since cgroup limits apply to
# everything the unit spawns — sudo does not escape them — every umbreld-backed
# command timed out, while the identical command from a shell worked fine.
#
# The quota was meant to stop the bot starving a small Pi. But the bot is idle
# almost all the time and only needs CPU during the few seconds it is actually
# answering you, so throttling it punishes exactly the moment it is useful.
# MemoryMax below is the limit that actually contains it; 10.1s under a 128M
# cap in the same test shows memory was never the constraint.
CPUQuota=100%
# NOTE: NoNewPrivileges is intentionally NOT set — the bot uses `sudo -n` to
# invoke scripts/system_control.sh for /system_reboot, /system_shutdown,
# /restart_docker, /restart_umbrel. Sudo needs setuid to escalate to root,
# which NoNewPrivileges=yes blocks. The privilege boundary is enforced by
# /etc/sudoers.d/umbrel-guardian-system, which permits only an explicit list:
# the five subcommands of system_control.sh plus the read-only disk_health.sh
# and verify_backup.sh diagnostics — nothing else.

[Install]
WantedBy=multi-user.target
